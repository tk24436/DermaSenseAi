# DermaSense AI — Root Environment Configuration Template
# Copy this file to .env before starting services with docker-compose

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dermasense
POSTGRES_PORT=5432

# Backend Spring Boot Configuration
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/dermasense
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=DermaSenseAiSuperSecretKeyThatIsAtLeast256BitsLongForSecureJwtAuth2026!
JWT_EXPIRATION_MS=86400000

# MinIO / Object Storage Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
