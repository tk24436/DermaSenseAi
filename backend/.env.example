# DermaSense AI - Backend Environment Variables
PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/dermasense
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security Configuration
# Must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=DermaSenseAiSuperSecretKeyThatIsAtLeast256BitsLongForSecureJwtAuth2026!
JWT_EXPIRATION_MS=86400000
