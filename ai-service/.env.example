# Database configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/dermasense

# Object Storage configuration (MinIO locally)
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=dermasense-images

# Analyzer configuration
# Set to 'facepp' or 'onnx'
ACTIVE_ANALYZER=facepp

# Face++ configuration
FACEPP_API_KEY=your_facepp_key_here
FACEPP_API_SECRET=your_facepp_secret_here
FACEPP_BASE_URL=https://api-us.faceplusplus.com/facepp/v1/skinanalyze
